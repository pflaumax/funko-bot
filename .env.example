# Bluesky Account Configuration
# Create a NEW Bluesky account for the bot at https://bsky.app
# Then go to Settings -> App Passwords -> Add App Password
# Use the full handle format: username.bsky.social
BLUESKY_HANDLE=your-bot-handle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Bot Configuration
CHECK_INTERVAL_MINUTES=180
FANDOMS=All

# Rate Limiting
# Posts 1 product every 3 hours = 8 posts/day
MAX_POSTS_PER_CHECK=1
POST_DELAY_SECONDS=0

# Pages to Scrape (comma-separated, 20 products each)
# Options: sale, new-releases, back-in-stock, exclusives, best-selling
SCRAPE_PAGES=sale,new-releases,back-in-stock,exclusives,best-selling

# Scraping Delays (seconds) - Random delay between min and max to avoid detection
# Increase these if Cloudflare blocks the bot
SCRAPE_DELAY_MIN=10
SCRAPE_DELAY_MAX=20

# Funko Region — decides which storefront is scraped, and therefore the
# currency of the prices that get posted. Nothing is ever converted: the
# price shown is the price that storefront charges.
# US (USD): us, or leave empty
# UK (GBP): gb, uk
# Europe (EUR): pl, de, fr, es, it, nl, be, at, ro, etc.
FUNKO_REGION=us

# Logging Configuration
LOG_LEVEL=INFO

# Optional: Test Mode
TEST_MODE=false
DRY_RUN=false
